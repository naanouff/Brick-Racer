{
  "name": "Standard Lit Pipeline (Lean: Shadows + Skybox)",
  "resources": [
    {
      "name": "shadowMap",
      "format": "depth32float",
      "sizeType": "absolute",
      "width": 2048,
      "height": 2048,
      "usage": 22
    },
    {
      "name": "sceneDepth",
      "format": "depth24plus",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "sceneColor",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    }
  ],
  "passes": [
    {
      "name": "02_Opaques",
      "type": "raster",
      "inputs": ["shadowMap"],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "queueTags": ["opaque"],
      "colorLoadOp": "clear",
      "depthLoadOp": "clear",
      "clearColor": { "r": 0.02, "g": 0.02, "b": 0.02, "a": 1.0 }
    },
    {
      "name": "03_Skybox",
      "type": "raster",
      "inputs": [],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "builtInPipeline": "skybox",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "vertexCount": 36,
      "skyboxParams": {
        "sunSize": 0.05,
        "sunBloom": 1.0,
        "starsThreshold": 0.995,
        "timeOfDay": 12.0,
        "clouds": { "density": 0.5, "scale": 2.5, "speed": 0.05, "brightness": 1.0 },
        "gradientStops": [
          { "offset": 0.0, "color": [0.01, 0.01, 0.02] },
          { "offset": 0.5, "color": [0.4, 0.6, 1.0] },
          { "offset": 1.0, "color": [0.1, 0.3, 0.8] }
        ]
      }
    },
    {
      "name": "04_Transparents",
      "type": "raster",
      "inputs": ["shadowMap"],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "queueTags": ["transparent"],
      "colorLoadOp": "load",
      "depthLoadOp": "load"
    },
    {
      "name": "Tone Mapping & Output",
      "type": "fullscreen",
      "inputs": ["sceneColor"],
      "outputs": ["FINAL_OUTPUT"],
      "shaderPath": "/shaders/post-processing/tonemapping.frag.wgsl",
      "uniforms": { "exposure": { "type": "f32", "value": 1.0 } }
    },
    {
      "name": "Debug Lines Pass",
      "type": "raster",
      "inputs": ["sceneDepth"],
      "outputs": ["FINAL_OUTPUT"],
      "viewType": "main",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "builtInPipeline": "debug"
    }
  ]
}
