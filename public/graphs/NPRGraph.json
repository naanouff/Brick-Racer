{
  "name": "NPR Pipeline (HBAO + Outlines + Hatching + Grading + FXAA)",
  "resources": [
    {
      "name": "shadowMap",
      "format": "depth32float",
      "sizeType": "absolute",
      "width": 2048,
      "height": 2048,
      "usage": 22
    },
    {
      "name": "sceneDepth",
      "format": "depth24plus",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "sceneColor",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "normalBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "ldrBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "gradingBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "lutTexture",
      "format": "rgba8unorm",
      "sizeType": "absolute",
      "width": 256,
      "height": 16,
      "usage": 22
    },
    {
      "name": "outlineBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "hatchBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "hbaoRaw",
      "format": "r8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "hbaoBlurred",
      "format": "r8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "aoSceneColor",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    }
  ],
  "passes": [
    {
      "name": "01_Shadows",
      "type": "raster",
      "inputs": [],
      "outputs": ["shadowMap"],
      "viewType": "shadow",
      "depthLoadOp": "clear",
      "queueTags": ["shadow_caster"]
    },
    {
      "name": "02_Opaques",
      "type": "raster",
      "inputs": ["shadowMap"],
      "outputs": ["sceneColor", "sceneDepth", "normalBuffer"],
      "viewType": "main",
      "queueTags": ["opaque"],
      "colorLoadOp": "clear",
      "depthLoadOp": "clear",
      "clearColor": { "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 }
    },
    {
      "name": "02b_Decals",
      "type": "decal",
      "inputs": ["sceneDepth"],
      "outputs": ["sceneColor"],
      "shaderPath": "/shaders/core/decal.wgsl"
    },
    {
      "name": "03_Skybox",
      "type": "raster",
      "inputs": [],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "builtInPipeline": "skybox",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "vertexCount": 36,
      "skyboxParams": {
        "sunSize": 0.05,
        "sunBloom": 1.0,
        "starsThreshold": 0.995,
        "timeOfDay": 12.0,
        "clouds": { "density": 0.5, "scale": 2.5, "speed": 0.05, "brightness": 1.0 },
        "gradientStops": [
          { "offset": 0.0, "color": [0.01, 0.01, 0.02] },
          { "offset": 0.5, "color": [0.4, 0.6, 1.0] },
          { "offset": 1.0, "color": [0.1, 0.3, 0.8] }
        ]
      }
    },
    {
      "name": "04_Transparents",
      "type": "raster",
      "inputs": ["shadowMap"],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "queueTags": ["transparent"],
      "colorLoadOp": "load",
      "depthLoadOp": "load"
    },
    {
      "name": "04b_HBAO",
      "type": "fullscreen",
      "inputs": ["sceneDepth", "normalBuffer"],
      "outputs": ["hbaoRaw"],
      "outputFormat": "r8unorm",
      "shaderPath": "/shaders/post-processing/hbao.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "hbaoParams": { "type": "struct", "value": [2.0, 1.5, 0.1, 4.0] }
      }
    },
    {
      "name": "04c_HBAO_Blur",
      "type": "fullscreen",
      "inputs": ["sceneDepth", "hbaoRaw"],
      "outputs": ["hbaoBlurred"],
      "outputFormat": "r8unorm",
      "shaderPath": "/shaders/post-processing/hbao_blur.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "blurParams": { "type": "struct", "value": [8.0, 0.0, 0.0, 0.0] }
      }
    },
    {
      "name": "04d_HBAO_Apply",
      "type": "fullscreen",
      "inputs": ["sceneColor", "hbaoBlurred"],
      "outputs": ["aoSceneColor"],
      "outputFormat": "rgba16float",
      "shaderPath": "/shaders/post-processing/hbao_apply.frag.wgsl"
    },
    {
      "name": "05_ToneMapping",
      "type": "fullscreen",
      "inputs": ["aoSceneColor"],
      "outputs": ["ldrBuffer"],
      "outputFormat": "rgba8unorm",
      "shaderPath": "/shaders/post-processing/tonemapping.frag.wgsl",
      "uniforms": { "exposure": { "type": "f32", "value": 1.0 } }
    },
    {
      "name": "05b_SobelOutline",
      "type": "fullscreen",
      "inputs": ["ldrBuffer", "sceneDepth", "normalBuffer"],
      "outputs": ["outlineBuffer"],
      "outputFormat": "rgba8unorm",
      "shaderPath": "/shaders/post-processing/sobel_outline.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "params": { "type": "struct", "value": [1.5, 0.1, 1.2, 0.05, 0.05, 0.05] }
      }
    },
    {
      "name": "05c_HatchedShadows",
      "type": "fullscreen",
      "inputs": ["outlineBuffer", "sceneDepth", "normalBuffer"],
      "outputs": ["hatchBuffer"],
      "outputFormat": "rgba8unorm",
      "shaderPath": "/shaders/post-processing/hatched_shadows.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "params": { "type": "struct", "value": [8.0, 0.7, 0.18, 0.5, 0.785, -0.785] }
      }
    },
    {
      "name": "06_ColorGrading",
      "type": "fullscreen",
      "inputs": ["hatchBuffer", "lutTexture"],
      "outputs": ["gradingBuffer"],
      "outputFormat": "rgba8unorm",
      "shaderPath": "/shaders/post-processing/color_grading.frag.wgsl",
      "uniforms": {
        "params": { "type": "struct", "value": [1.0] }
      }
    },
    {
      "name": "07_FXAA",
      "type": "fullscreen",
      "inputs": ["gradingBuffer"],
      "outputs": ["FINAL_OUTPUT"],
      "shaderPath": "/shaders/post-processing/fxaa.frag.wgsl"
    },
    {
      "name": "99_DebugLines",
      "type": "raster",
      "inputs": ["sceneDepth"],
      "outputs": ["FINAL_OUTPUT"],
      "viewType": "main",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "builtInPipeline": "debug"
    }
  ]
}
