{
  "name": "Standard Lit — Showcase (studio sky + HBAO + tonemap + FXAA)",
  "resources": [
    {
      "name": "shadowMap",
      "format": "depth32float",
      "sizeType": "absolute",
      "width": 2048,
      "height": 2048,
      "usage": 23
    },
    {
      "name": "sceneDepth",
      "format": "depth24plus",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "sceneColor",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 23
    },
    {
      "name": "normalBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "sceneColorRefract",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 6
    },
    {
      "name": "hbaoRaw",
      "format": "r8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "hbaoBlurred",
      "format": "r8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "aoSceneColor",
      "format": "rgba16float",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    },
    {
      "name": "ldrBuffer",
      "format": "rgba8unorm",
      "sizeType": "relative",
      "width": 1.0,
      "height": 1.0,
      "usage": 22
    }
  ],
  "passes": [
    {
      "name": "01_Shadows",
      "type": "raster",
      "inputs": [],
      "outputs": ["shadowMap"],
      "viewType": "shadow",
      "depthLoadOp": "clear",
      "queueTags": ["shadow_caster"]
    },
    {
      "name": "02_Opaques",
      "type": "raster",
      "inputs": ["shadowMap"],
      "outputs": ["sceneColor", "sceneDepth", "normalBuffer"],
      "viewType": "main",
      "queueTags": ["opaque"],
      "colorLoadOp": "clear",
      "depthLoadOp": "clear",
      "clearColor": { "r": 0.14, "g": 0.142, "b": 0.145, "a": 1.0 }
    },
    {
      "name": "03_Skybox",
      "type": "raster",
      "inputs": [],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "builtInPipeline": "skybox",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "vertexCount": 36,
      "skyboxParams": {
        "sunSize": 0.035,
        "sunBloom": 0.45,
        "starsThreshold": 0.999,
        "timeOfDay": 12.0,
        "clouds": { "density": 0.04, "scale": 5.0, "speed": 0.015, "brightness": 0.55 },
        "gradientStops": [
          { "offset": 0.0, "color": [0.11, 0.112, 0.118] },
          { "offset": 0.5, "color": [0.26, 0.265, 0.27] },
          { "offset": 1.0, "color": [0.16, 0.162, 0.168] }
        ]
      }
    },
    {
      "name": "03b_CopySceneForRefraction",
      "type": "copy-texture",
      "inputs": ["sceneColor"],
      "outputs": ["sceneColorRefract"]
    },
    {
      "name": "04_Transparents",
      "type": "raster",
      "inputs": ["shadowMap", "sceneColorRefract"],
      "outputs": ["sceneColor", "sceneDepth"],
      "viewType": "main",
      "queueTags": ["transparent"],
      "colorLoadOp": "load",
      "depthLoadOp": "load"
    },
    {
      "name": "04b_HBAO",
      "type": "fullscreen",
      "inputs": ["sceneDepth", "normalBuffer"],
      "outputs": ["hbaoRaw"],
      "outputFormat": "r8unorm",
      "shaderPath": "/shaders/post-processing/hbao.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "hbaoParams": { "type": "struct", "value": [2.0, 1.28, 0.065, 4.0] }
      }
    },
    {
      "name": "04c_HBAO_Blur",
      "type": "fullscreen",
      "inputs": ["sceneDepth", "hbaoRaw"],
      "outputs": ["hbaoBlurred"],
      "outputFormat": "r8unorm",
      "shaderPath": "/shaders/post-processing/hbao_blur.frag.wgsl",
      "useFrameUniforms": true,
      "uniforms": {
        "blurParams": { "type": "struct", "value": [8.0, 0.0, 0.0, 0.0] }
      }
    },
    {
      "name": "04d_HBAO_Apply",
      "type": "fullscreen",
      "inputs": ["sceneColor", "hbaoBlurred"],
      "outputs": ["aoSceneColor"],
      "outputFormat": "rgba16float",
      "shaderPath": "/shaders/post-processing/hbao_apply.frag.wgsl"
    },
    {
      "name": "Tone Mapping & Output",
      "type": "fullscreen",
      "inputs": ["aoSceneColor"],
      "outputs": ["ldrBuffer"],
      "outputFormat": "rgba8unorm",
      "shaderPath": "/shaders/post-processing/tonemapping.frag.wgsl",
      "uniforms": { "exposure": { "type": "f32", "value": 0.9 } }
    },
    {
      "name": "07_FXAA",
      "type": "fullscreen",
      "inputs": ["ldrBuffer"],
      "outputs": ["FINAL_OUTPUT"],
      "shaderPath": "/shaders/post-processing/fxaa.frag.wgsl"
    },
    {
      "name": "Debug Lines Pass",
      "type": "raster",
      "inputs": ["sceneDepth"],
      "outputs": ["FINAL_OUTPUT"],
      "viewType": "main",
      "colorLoadOp": "load",
      "depthLoadOp": "load",
      "builtInPipeline": "debug"
    }
  ]
}
