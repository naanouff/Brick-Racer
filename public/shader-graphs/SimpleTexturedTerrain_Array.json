      "toSocketId": "b"
    },

    {
      "fromNodeId": "sample_layer1",
      "fromSocketId": "rgb",
      "toNodeId": "layer1_scaled",
      "toSocketId": "a"
    },
    {
      "fromNodeId": "blend_factor",
      "fromSocketId": "out",
      "toNodeId": "layer1_scaled",
      "toSocketId": "b"
    },

    {
      "fromNodeId": "layer0_scaled",
      "fromSocketId": "out",
      "toNodeId": "albedo_blend",
      "toSocketId": "a"
    },
    {
      "fromNodeId": "layer1_scaled",
      "fromSocketId": "out",
      "toNodeId": "albedo_blend",
      "toSocketId": "b"
    },

    {
      "fromNodeId": "albedo_blend",
      "fromSocketId": "out",
      "toNodeId": "f_master",
      "toSocketId": "albedo"
    },
    {
      "fromNodeId": "blend_factor",
      "fromSocketId": "out",
      "toNodeId": "f_master",
      "toSocketId": "opacity"
    },
    {
      "fromNodeId": "get_norm",
      "fromSocketId": "out",
      "toNodeId": "f_master",
      "toSocketId": "normal"
    },
    {
      "fromNodeId": "rough_prop",
      "fromSocketId": "out",
      "toNodeId": "f_master",
      "toSocketId": "roughness_factor"
    },
    {
      "fromNodeId": "metal_prop",
      "fromSocketId": "out",
      "toNodeId": "f_master",
      "toSocketId": "metallic_factor"
    }
  ]
