      "toNodeId": "v_master",
      "toSocketId": "normal"
    },

    { "fromNodeId": "get_uv", "fromSocketId": "uv", "toNodeId": "uv_scaled", "toSocketId": "a" },
    { "fromNodeId": "uv_scale", "fromSocketId": "out", "toNodeId": "uv_scaled", "toSocketId": "b" },

    {
      "fromNodeId": "tex_array_prop",
      "fromSocketId": "out",
