      "toSocketId": "texture"
    },
    {
      "fromNodeId": "layer0_index",
      "fromSocketId": "out",
      "toNodeId": "sample_layer0",
      "toSocketId": "layer"
    },
    {
      "fromNodeId": "uv_scaled",
      "fromSocketId": "out",
      "toNodeId": "sample_layer0",
      "toSocketId": "uv"
    },

    {
      "fromNodeId": "tex_array_prop",
      "fromSocketId": "out",
      "toNodeId": "sample_layer1",
      "toSocketId": "texture"
    },
    {
      "fromNodeId": "layer1_index",
      "fromSocketId": "out",
      "toNodeId": "sample_layer1",
      "toSocketId": "layer"
    },
    {
      "fromNodeId": "uv_scaled",
      "fromSocketId": "out",
      "toNodeId": "sample_layer1",
      "toSocketId": "uv"
    },

    {
      "fromNodeId": "sample_layer0",
      "fromSocketId": "rgb",
      "toNodeId": "layer0_scaled",
      "toSocketId": "a"
    },
    {
      "fromNodeId": "blend_factor",
      "fromSocketId": "out",
