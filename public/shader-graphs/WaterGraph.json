      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "mul_amp",
      "type": "Multiply",
      "stage": "common",
      "position": { "x": 750, "y": 150 },
      "inputs": [
        { "id": "a", "name": "A", "dataType": "f32" },
        { "id": "b", "name": "B", "dataType": "f32" }
      ],
      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "add_y_offset",
      "type": "Add",
      "stage": "common",
      "position": { "x": 600, "y": -50 },
      "inputs": [
        { "id": "a", "name": "Y Base", "dataType": "f32" },
        { "id": "b", "name": "Y Wave", "dataType": "f32" }
