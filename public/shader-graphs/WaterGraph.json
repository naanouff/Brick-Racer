  "connections": [
    { "fromNodeId": "get_pos", "fromSocketId": "out", "toNodeId": "split_pos", "toSocketId": "in" },
    { "fromNodeId": "split_pos", "fromSocketId": "x", "toNodeId": "add_xz", "toSocketId": "a" },
    { "fromNodeId": "split_pos", "fromSocketId": "z", "toNodeId": "add_xz", "toSocketId": "b" },
    { "fromNodeId": "add_xz", "fromSocketId": "out", "toNodeId": "mul_freq", "toSocketId": "a" },
    { "fromNodeId": "prop_freq", "fromSocketId": "out", "toNodeId": "mul_freq", "toSocketId": "b" },
    { "fromNodeId": "get_time", "fromSocketId": "out", "toNodeId": "mul_speed", "toSocketId": "a" },
    {
      "fromNodeId": "prop_speed",
      "fromSocketId": "out",
      "toNodeId": "mul_speed",
      "toSocketId": "b"
    },
    { "fromNodeId": "mul_freq", "fromSocketId": "out", "toNodeId": "add_time", "toSocketId": "a" },
    { "fromNodeId": "mul_speed", "fromSocketId": "out", "toNodeId": "add_time", "toSocketId": "b" },
    { "fromNodeId": "add_time", "fromSocketId": "out", "toNodeId": "sin_wave", "toSocketId": "a" },
    { "fromNodeId": "sin_wave", "fromSocketId": "out", "toNodeId": "mul_amp", "toSocketId": "a" },
    { "fromNodeId": "prop_amp", "fromSocketId": "out", "toNodeId": "mul_amp", "toSocketId": "b" },

    {
      "fromNodeId": "split_pos",
      "fromSocketId": "y",
      "toNodeId": "add_y_offset",
      "toSocketId": "a"
    },
    {
      "fromNodeId": "mul_amp",
      "fromSocketId": "out",
      "toNodeId": "add_y_offset",
      "toSocketId": "b"
    },

    { "fromNodeId": "split_pos", "fromSocketId": "x", "toNodeId": "new_pos", "toSocketId": "x" },
    {
      "fromNodeId": "add_y_offset",
      "fromSocketId": "out",
      "toNodeId": "new_pos",
      "toSocketId": "y"
    },
    { "fromNodeId": "split_pos", "fromSocketId": "z", "toNodeId": "new_pos", "toSocketId": "z" },

    {
      "fromNodeId": "new_pos",
      "fromSocketId": "out",
      "toNodeId": "master_vtx",
      "toSocketId": "position"
    },
    {
      "fromNodeId": "get_norm",
      "fromSocketId": "out",
      "toNodeId": "master_vtx",
      "toSocketId": "normal"
    },

    {
      "fromNodeId": "prop_color",
      "fromSocketId": "out",
      "toNodeId": "master_frag",
      "toSocketId": "albedo"
    },
    {
      "fromNodeId": "prop_alpha",
      "fromSocketId": "out",
      "toNodeId": "master_frag",
      "toSocketId": "alpha"
    }
  ]
