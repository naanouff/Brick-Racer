  "nodes": [
    {
      "id": "master_vtx",
      "type": "VertexMasterNode",
      "stage": "vertex",
      "position": { "x": 1000, "y": 100 },
      "inputs": [
        { "id": "position", "name": "Position", "dataType": "vec3f" },
        { "id": "normal", "name": "Normal", "dataType": "vec3f" }
      ],
      "outputs": []
    },
    {
      "id": "get_pos",
      "type": "GetPosition",
      "stage": "vertex",
      "position": { "x": 100, "y": 0 },
      "inputs": [],
      "outputs": [{ "id": "out", "name": "Vec3", "dataType": "vec3f" }]
    },
    {
      "id": "get_norm",
      "type": "GetNormal",
      "stage": "vertex",
      "position": { "x": 800, "y": 300 },
      "inputs": [],
      "outputs": [{ "id": "out", "name": "Vec3", "dataType": "vec3f" }]
    },
    {
      "id": "get_time",
      "type": "Time",
      "stage": "common",
      "position": { "x": 100, "y": 300 },
      "inputs": [],
      "outputs": [{ "id": "out", "name": "Value", "dataType": "f32" }]
    },
    {
      "id": "prop_freq",
      "type": "Property",
      "stage": "common",
      "position": { "x": 100, "y": 400 },
      "data": { "propertyName": "waveFrequency" },
      "outputs": [{ "id": "out", "name": "Value", "dataType": "f32" }]
    },
    {
      "id": "prop_amp",
      "type": "Property",
      "stage": "common",
      "position": { "x": 400, "y": 500 },
      "data": { "propertyName": "waveAmplitude" },
      "outputs": [{ "id": "out", "name": "Value", "dataType": "f32" }]
    },
    {
      "id": "prop_speed",
      "type": "Property",
      "stage": "common",
      "position": { "x": 100, "y": 500 },
      "data": { "propertyName": "waveSpeed" },
      "outputs": [{ "id": "out", "name": "Value", "dataType": "f32" }]
    },
    {
      "id": "split_pos",
      "type": "SplitVec3",
      "stage": "common",
      "position": { "x": 300, "y": 0 },
      "inputs": [{ "id": "in", "name": "In", "dataType": "vec3f" }],
      "outputs": [
        { "id": "x", "name": "X", "dataType": "f32" },
        { "id": "y", "name": "Y", "dataType": "f32" },
        { "id": "z", "name": "Z", "dataType": "f32" }
      ]
    },
    {
      "id": "add_xz",
      "type": "Add",
      "stage": "common",
      "position": { "x": 450, "y": 0 },
      "inputs": [
        { "id": "a", "name": "A", "dataType": "f32" },
        { "id": "b", "name": "B", "dataType": "f32" }
      ],
      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "mul_freq",
      "type": "Multiply",
      "stage": "common",
      "position": { "x": 600, "y": 0 },
      "inputs": [
        { "id": "a", "name": "A", "dataType": "f32" },
        { "id": "b", "name": "B", "dataType": "f32" }
      ],
      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "mul_speed",
      "type": "Multiply",
      "stage": "common",
      "position": { "x": 300, "y": 400 },
      "inputs": [
        { "id": "a", "name": "A", "dataType": "f32" },
        { "id": "b", "name": "B", "dataType": "f32" }
      ],
      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "add_time",
      "type": "Add",
      "stage": "common",
      "position": { "x": 750, "y": 0 },
      "inputs": [
        { "id": "a", "name": "A", "dataType": "f32" },
        { "id": "b", "name": "B", "dataType": "f32" }
      ],
      "outputs": [{ "id": "out", "name": "Out", "dataType": "f32" }]
    },
    {
      "id": "sin_wave",
      "type": "Sin",
      "stage": "common",
      "position": { "x": 900, "y": 0 },
