{
  "id": "WaterGraphAnimated",
  "properties": {
    "waterColor": { "type": "vec3f", "defaultValue": [0.1, 0.3, 0.5], "name": "Couleur de l'eau" },
    "alpha": { "type": "f32", "defaultValue": 0.8, "name": "Transparence" },
    "waveFrequency": { "type": "f32", "defaultValue": 0.1, "name": "Fréquence Vagues" },
    "waveAmplitude": { "type": "f32", "defaultValue": 0.2, "name": "Amplitude Vagues" },
    "waveSpeed": { "type": "f32", "defaultValue": 1.0, "name": "Vitesse Vagues" }
